# -*- mode: shell-script; -*-

# =============================================================================
# Instant prompt (Powerlevel10k)
# Must stay near the top. Anything that may need console input goes above this.
# =============================================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =============================================================================
# Autoload — custom zsh functions
# =============================================================================
ZFUNCDIR=$HOME/.zfunctions
fpath=($ZFUNCDIR $fpath)
autoload -Uz $ZFUNCDIR/*(.:t)

# =============================================================================
# Plugins — antidote
# =============================================================================
if is-macos; then
    # for macos
    source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
else
    # Clone antidote if necessary.
    if [[ ! -d $HOME/.antidote ]]; then
        git clone https://github.com/mattmc3/antidote $HOME/.antidote
    fi

    # Create an amazing Zsh config using antidote plugins.
    source $HOME/.antidote/antidote.zsh
fi

# Skip daily security scans when zcompdump is fresh (ez-compinit).
# NOTE: Caching zcompdump improves startup speed but can mask $fpath changes.
# If completions stop working after updating your fpath, delete the cache file
# (~/.zcompcache/*) or disable caching and restart your shell.
# Enable with caution:
# zstyle ':completion::complete:*' use-cache yes
zstyle ':plugin:ez-compinit' 'use-cache' 'yes'

antidote load

# =============================================================================
# Completion
# Run compsys now (not on first precmd) so carapace/fzf compdefs aren't queued.
# =============================================================================
(( $+functions[run-compinit] )) && run-compinit

# =============================================================================
# Prompt — Powerlevel10k
# Customize with `p10k configure` or edit ~/.p10k.zsh.
# =============================================================================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# =============================================================================
# Tool init cache helper
# Avoids process substitution (carapace / zoxide / …) on every startup.
# =============================================================================
_zsh_cache_init() {
  local bin=$1 out=$2
  shift 2
  [[ -r $out && ! $bin -nt $out ]] || {
    mkdir -p -- ${out:h} || return
    "$@" >|$out || return
    zcompile -U -- $out 2>/dev/null &!
  }
  source -- $out
}

# =============================================================================
# Fuzzy finder — fzf
# =============================================================================
if [[ -f ~/.fzf.zsh ]]; then
  . ~/.fzf.zsh
fi

# =============================================================================
# Completion — carapace
# =============================================================================
if (( $+commands[carapace] )); then
  export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense' # optional
  zstyle ':completion:*' format $'\e[2;37m-- Completing %d --\e[m'
  _zsh_cache_init $commands[carapace] ${XDG_CACHE_HOME:-$HOME/.cache}/zsh/carapace-init.zsh \
    carapace _carapace
fi

# =============================================================================
# Navigation — zoxide
# =============================================================================
if (( $+commands[zoxide] )); then
  _zsh_cache_init $commands[zoxide] ${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zoxide-init.zsh \
    zoxide init zsh
fi
unfunction _zsh_cache_init

# =============================================================================
# Keybindings
# =============================================================================
# Ctrl+Space accepts autosuggestion
bindkey '^ ' autosuggest-accept

# history-substring-search
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey -M emacs '^P' history-substring-search-up
bindkey -M emacs '^N' history-substring-search-down
if [[ -n ${terminfo[kcuu1]} ]]; then
    bindkey "${terminfo[kcuu1]}" history-substring-search-up
fi
if [[ -n ${terminfo[kcud1]} ]]; then
    bindkey "${terminfo[kcud1]}" history-substring-search-down
fi

# =============================================================================
# Aliases
# =============================================================================
alias eza="eza --icons=auto --hyperlink --color=always --color-scale=all --color-scale-mode=gradient --git --git-repos"
alias l="eza"
alias ls="eza"
alias ll='eza -lh'
alias la='eza -lAh'
alias g='git'
alias f='cd $(fd --type directory | fzf)'
alias cd..='cd ..'

alias grep='grep --color=auto'
alias archupdate="$HOME/github/scripts/archupdate"

alias vi='vim'

# =============================================================================
# Functions
# =============================================================================
function cpwd {
    local target_path

    if [[ $# -eq 0 ]]; then
        target_path="$PWD"
    else
        if [[ -f "$1" ]]; then
            target_path="$(realpath "$1")"
        elif [[ -d "$1" ]]; then
            target_path="$(realpath "$1")"
        else
            if [[ "$1" == /* ]]; then
                target_path="$1"
            else
                target_path="$PWD/$1"
            fi
        fi
    fi

    if [[ "${OSTYPE}" == darwin* ]] && (( ${+commands[pbcopy]} )); then
        print -n "$target_path" | pbcopy
    elif [ -n "${WAYLAND_DISPLAY:-}" ] && (( ${+commands[wl-copy]} )); then
        print -n "$target_path" | wl-copy
    elif [ -n "${DISPLAY:-}" ] && (( ${+commands[xsel]} )); then
        print -n "$target_path" | xsel -b
    elif [ -n "${DISPLAY:-}" ] && (( ${+commands[xclip]} )); then
        print -n "$target_path" | xclip -selection clipboard
    else
        echo "Error: No clipboard tool found. Please install:"
        echo "  - macOS: pbcopy (built-in)"
        echo "  - Linux: xclip or xsel (e.g., sudo apt install xclip)"
        return 1
    fi

    if [[ $# -eq 0 ]]; then
        echo 'Current directory path copied to clipboard'
    else
        echo "Path copied to clipboard: $target_path"
    fi
}

# =============================================================================
# Environment — rustup mirror
# =============================================================================
export RUSTUP_DIST_SERVER="https://rsproxy.cn"
export RUSTUP_UPDATE_ROOT="https://rsproxy.cn/rustup"

# =============================================================================
# Environment — pnpm
# =============================================================================
export PNPM_HOME="${HOME}/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# Generate with: pnpm completion zsh > ~/completion-for-pnpm.zsh
[[ -f ~/completion-for-pnpm.zsh ]] && source ~/completion-for-pnpm.zsh

